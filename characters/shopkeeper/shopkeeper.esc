:look
	say($olda, "Prodavač. Vypadá, že tu stojí od rána do noci.")

:talk
	set_global("shop_reward_now", false)
	if game_day == 1:
		?!
			- "Nemáte nějaké hodinky? Klidně levné... nebo zadarmo?" [not shop_deal]
				say($shopkeeper, "Zadarmo nic není. Ale...")
				say($shopkeeper, "Venku sedí opilý chlap a řve na zákazníky. Když ho odeženete, dám vám hodinky.")
				set_global("shop_deal", true)
			- "Vykoupíte ode mě zálohované lahve?" [(bottles_taken and not bottles_returned) or (bin_bottles_taken and not bin_bottles_returned)]
				say($shopkeeper, "Lahve? Dobře, pár korun za ně dostanete.")
				if bottles_taken and not bottles_returned:
					inventory_remove("bottles")
					set_global("bottles_returned", true)
				if bin_bottles_taken and not bin_bottles_returned:
					inventory_remove("trash_bottles")
					set_global("bin_bottles_returned", true)
			- "Opilec je pryč." [shop_deal and drunk_gone and not watch_taken]
				set_global("shop_reward_now", true)
				done
			- "Nic, jen se dívám."
				done
	else:
		say($shopkeeper, "Dobrý den, co si dáte?")
		?!
			- "Vykoupíte ode mě zálohované lahve?" [(bottles_taken and not bottles_returned) or (bin_bottles_taken and not bin_bottles_returned)]
				say($shopkeeper, "Lahve? Dobře, pár korun za ně dostanete.")
				if bottles_taken and not bottles_returned:
					inventory_remove("bottles")
					set_global("bottles_returned", true)
				if bin_bottles_taken and not bin_bottles_returned:
					inventory_remove("trash_bottles")
					set_global("bin_bottles_returned", true)
			- "Prodáváte i kamery?" [game_day == 4 and neighbor_talked and not camera_bought]
				say($shopkeeper, "Kamery? Mám. Malá, na baterku, nahrává celou noc. Pět stovek.")
				say($olda, "Beru.")
				inventory_add("camera")
				set_global("camera_bought", true)
				say($shopkeeper, "Kdyby něco, přineste mi ji. Záznam vám přetáhnu do počítače.")
			- "Byl jsem tu dnes v noci?" [game_day == 5 and not shop_testimony]
				set_global("shop_testimony", true)
				set_global("diary_shop_testimony", true)
				say($shopkeeper, "Vy si to nepamatujete? Tři čtvrtě na dvě. Klepal jste na okýnko.")
				say($shopkeeper, "Koupil jste nůž. Ten velkej kuchyňskej. Ani jste nesmlouval.")
				say($shopkeeper, "A mluvil jste sám se sebou. Jiným hlasem. Jako by vás tam bylo víc.")
				say($shopkeeper, "Říkal jsem si, že jste opilej. Ale nebyl. Usmíval jste se.")
				say($aidam, "Unavenej prodavač ve dvě ráno. Výbornej svědek.", "", "avatar")
				say($olda, "Máte to na kameře?")
				say($shopkeeper, "Mám. Pojďte sem za pult.")
				set_global("footage_kind", "shop")
				set_global("footage_now", true)
				done
			- "Přehrajete mi záznam z téhle kamery?" [game_day == 5 and camera_taken and not camera_footage_seen]
				say($shopkeeper, "Ta, co jsem vám prodal? Ukažte.")
				say($shopkeeper, "Přetáhnu to do počítače. Moment.")
				set_global("footage_kind", "camera")
				set_global("footage_now", true)
				done
			- "Vezmete lahve a drobný na účet?" [bag_points > 0]
				if not shop_credit_explained:
					set_global("shop_credit_explained", true)
					say($shopkeeper, "Napíšu vám to na účet. Až budete něco potřebovat, odečtu.")
				else:
					say($shopkeeper, "Připíšu.")
				set_global("shop_credit", shop_credit + bag_points)
				set_global("bag_points", 0)
				inventory_remove("collected_bag")
			- "Dejte mi energetik. Na účet." [game_day == 5 and shop_credit >= 2]
				set_global("shop_credit", shop_credit - 2)
				set_global("energy_drinks", energy_drinks + 1)
				inventory_add("energy_drink")
				say($shopkeeper, "Tady. Nepijte jich moc najednou.")
			- "Dejte mi energetik." [game_day == 5 and shop_credit < 2]
				say($shopkeeper, "Bez peněz nic. Leda byste přinesl lahve.")
			- "Nic, jen se dívám."
				done
	
	# Sobota: přehrání záznamu (scéna footage).
	if footage_now:
		set_global("footage_now", false)
		change_scene("res://rooms/footage/footage.tscn")

	if shop_reward_now:
		if booth_coins_taken and machine_coins_taken and bottles_returned and bin_bottles_returned:
			say($shopkeeper, "Díky! A vy máte i peníze, tak si vyberte barvu.")
			?!
				- "Černé."
					set_global("watch_color", "black")
					done
				- "Stříbrné."
					set_global("watch_color", "silver")
					done
				- "Zlaté."
					set_global("watch_color", "gold")
					done
		else:
			say($shopkeeper, "Díky! Můžu vám dát levné hodinky hned.")
			say($shopkeeper, "Ale kdybyste měl pár korun navíc, dám vám hezčí a vyberete si barvu.")
			# AIdam napoví, kde ještě jsou peníze.
			if not booth_coins_taken:
				say($aidam, "V telefonní budce jsme se ještě nedívali. Vyber ruku a klikni na budku.", "", "avatar")
			if not machine_coins_taken:
				say($aidam, "A co vracení mincí v automatu na kafe?", "", "avatar")
			if not bottles_taken or not bin_bottles_taken:
				say($aidam, "Říkal jsem ti už, že jedna z mých nejoblíbenějších aktivit je vracet vratný lahve?", "", "avatar")
			if (bottles_taken and not bottles_returned) or (bin_bottles_taken and not bin_bottles_returned):
				say($aidam, "Lahve máš u sebe, tak mu je vrať.", "", "avatar")
			?!
				- "Přinesu víc peněz, chci si vybrat."
					set_global("shop_reward_now", false)
					done
				- "Dejte mi ty levné."
					done

	if shop_reward_now:
		inventory_add("watches")
		set_global("watch_taken", true)
		set_global("diary_watch_taken", true)
		say($aidam, "Konečně víme, kolik je hodin. Teď můžeš jít domů a vyřešíme spolu co dál.", "", "avatar")
