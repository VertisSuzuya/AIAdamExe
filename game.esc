:init
	show_menu("main")
:newgame
	#####################################MONDAY#####################################

	set_global("brick_taken", false)
	set_global("lab_flashbacks_done", false)
	set_global("lab_intro_done", false)

	#tutorial monday
	set_global("tutorial_step", 0)
	set_global("alarm_taken", false)
	set_global("battery_taken", false)
	set_global("alarm_set", false)

	# Čas a den (počítá autoload game_clock, viz systems/game_clock.gd)
	set_global("game_day", 0)
	set_global("day_minute", 420)
	set_global("day_phase", "morning")
	set_global("day_task_done", false)
	# Hodiny stojí, dokud se Olda v pondělí večer nedostane domů
	# (zapíná je :setup v oldas_room.esc).
	set_global("clock_enabled", false)
	# Nastaví postel, hodiny pak spustí :new_day (s mrknutím).
	set_global("sleep_requested", false)
	# Checkpoint dne (ukládá a načítá game_clock mimo běžné savy,
	# user://checkpoint/day.tres).
	set_global("checkpoint_pending", false)
	set_global("checkpoint_load_requested", false)

	# Deník AIdama (autoload diary, texty v diary/diary_entries.json).
	set_global("diary_alarm_set", false)

	# Příznaky z rozvrhu (:update_schedule je přepíše, tady jen výchozí hodnoty,
	# aby byly definované dřív, než je přečte :setup místnosti)
	set_global("shop_open", true)
	#####################################TUESDAY#####################################
									#tuasday home street#
	set_global("drunk_gone", false)
	set_global("bottles_taken", false)
	set_global("shop_deal", false)
	set_global("coffee_taken", false)
	set_global("coffee_given", false)
	set_global("machine_coins_taken", false)
	set_global("booth_coins_taken", false)
	set_global("bin_bottles_taken", false)
	set_global("bin_bottles_returned", false)
	set_global("bottles_returned", false)
	set_global("shop_reward_now", false)
	set_global("watch_taken", false)
	set_global("watch_color", "none")
	set_global("diary_drunk_gone", false)
	set_global("diary_watch_taken", false)
	set_global("drunk_talked", false)
	set_global("coins_have", false)
	set_global("coffee_made", false)
	set_global("ticket_taken", false)
	set_global("home_talk_done", false)
											#centrum#
	set_global("salon_seen", false)
	set_global("diary_salon_seen", false)
	
		#####################################WEDNESDAY#####################################
											#center city groom
	set_global("envelope_taken", false)
	set_global("money_taken", false)
	set_global("salon_pay_now", false)
	set_global("olda_groomed", false)
	set_global("diary_olda_groomed", false)
										#fit + cafe#
	set_global("students_talked", false)
	set_global("diary_students_talked", false)
	set_global("cafe_reserved", false)
	set_global("diary_cafe_reserved", false)
	set_global("concert_seen", false)
	set_global("wife_number_known", false)
	set_global("diary_wife_number", false)
	
	set_global("concert_play", false)
	set_global("concert_score", 0)
	
	#########################################THURSDAY############################################
	
	set_global("wife_called", false)
	set_global("diary_wife_called", false)
	set_global("family_met", false)
	set_global("diary_family_met", false)
	
		# Tramvaj
	set_global("tram_from", "home_street")
	set_global("tram_moving", false)
	set_global("tram_map_open", false)
	set_global("tram_target", "")
	# Zastávky na mapě (Domov je vždy)
	set_global("stop_dejvice", false)
	set_global("stop_in_laws", false)
	set_global("stop_center", false)
	set_global("diary_stop_dejvice", false)
	set_global("diary_stop_in_laws", false)
	set_global("diary_stop_center", false)
	
	#change_scene("res://rooms/oldas_room/oldas_room.tscn")
	change_scene("res://rooms/laboratory/laboratory.tscn")

:update_schedule
	# Rozvrh světa. Spouští ho game_clock při změně dne nebo části dne.
	# Z game_day (0 = pondělí ... 6 = neděle) a day_phase ("morning",
	# "afternoon", "evening", "night") spočítá příznaky pro místnosti.
	# Místnosti a dialogy čtou jen tyto příznaky, ne čas přímo.
	set_global("shop_open", (day_phase == "morning" or day_phase == "afternoon") and game_day != 6)

:time_fade_out
	# Mrknutí při změně části dne (spouští game_clock), pak se mění vzhled místnosti.
	# Třetí parametr je ve skutečnosti délka přechodu v sekundách
	# (esc_transition_player.gd), ne zpoždění, jak píše dokumentace.
	# Během mrknutí nejde klikat (klik by přerušil přechod a zůstala by tma).
	accept_input("NONE")
	transition("fade_black", "out", 0.5)

:time_fade_in
	transition("fade_black", "in", 0.5)
	accept_input("ALL")

:new_day
	# Spouští game_clock (ve tmě po :time_fade_out), když postel nastaví
	# sleep_requested.
	set_global("sleep_requested", false)
	set_global("game_day", game_day + 1)
	set_global("day_minute", 420)
	set_global("day_phase", "morning")
	set_global("day_task_done", false)
	# game_clock uloží checkpoint dne, až doběhne mrknutí a bude klid.
	set_global("checkpoint_pending", true)

:day_timeout
	# Spustí game_clock, když čas dojde do 2:00 a hráč nešel spát.
	# game_clock pak načte checkpoint dne (začátek dne i s inventářem a postupem).
	# Mluví current_player, mozna lepsi by Aidam
	# (say na objekt mimo místnost shodí hru).
	say("current_player", "Už jsou dvě ráno... Nějak se mi zavírají oči.")
	set_global("checkpoint_load_requested", true)

:day_reset
	# Náhrada, když checkpoint neexistuje (např. starý save): vrátí se jen čas
	# na začátek dne (pondělí 22:00, kdy Olda poprvé přijde domů, ostatní dny 7:00).
	if game_day == 0:
		set_global("day_minute", 1320)
	else:
		set_global("day_minute", 420)
	# change_scene na místnost, ve které hráč už je, shodí hru (chyba Escorie,
	# esc_room_manager.gd _check_and_prepare_managers_for_room), proto jen mimo pokoj.
	if ESC_CURRENT_SCENE != "oldas_room":
		change_scene("res://rooms/oldas_room/oldas_room.tscn")
		

:half_hour
	# Spouští game_clock každou celou půlhodinu. Připomínky podle dne a času.
	# Středa: koncert v 18:00 (připomínka v 17:00 a 17:30, mimo atrium).
	if game_day == 2 and students_talked and not concert_seen and ESC_CURRENT_SCENE != "fit_inside":
		if day_minute >= 1020 and day_minute < 1050:
			say($aidam, "Je pět. Za hodinu Mutanti! Ať jsme v atriu včas.", "", "avatar")
		elif day_minute >= 1050 and day_minute < 1080:
			say($aidam, "Půl šestý! Mutanti za půl hodiny. Rychle do atria na FIT!", "", "avatar")
