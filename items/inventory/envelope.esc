:look
	say($olda, "Obálka, není na ní ani napsaný od koho je.")
	say($aidam, "je v ní něco tlustýho.", "", "avatar")

:pickup
	inventory_add("envelope")
	set_active("envelope", false)
	set_global("envelope_taken", true)
	#otestovat jak moc intuitivni to je bez napovedy, napoveda ve stredu je celkem late
	say($aidam, "Vyber ozubené kolo, klikni na obálku a pak na sebe.", "", "avatar")

:use olda
	say($olda, "Peníze! Víc, než jsem čekal.")
	say($aidam, "Výplata pro pokusnýho králíka. Gratuluju, jsi zaměstnanec měsíce.", "", "avatar")
	say($olda, "Je tu i lísteček. Děkujeme za spolupráci, kontroly nejsou nutné.")
	say($aidam, "Kontroly nejsou nutné. To zní tak uklidňujícně, až to neuklidňuje.", "", "avatar")
	inventory_remove("envelope")
	inventory_add("money")
	set_global("money_taken", true)
