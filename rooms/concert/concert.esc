:setup
	# Během koncertu čas stojí (písničky hrají celou svou délku).
	set_global("clock_enabled", false)
	set_global("concert_play", false)
	# Hudba na pozadí (_music) hraje přes všechny místnosti, na koncertě ji vypneme.
	stop_snd("_music")

:ready
	# Klikání nesmí rozhovor přerušit (ALL vrátí Escoria po změně místnosti).
	accept_input("SKIP")
	say($aidam, "TO JSOU ONI! Mutanti hledaj východisko! Živě!", "", "avatar")
	say($aidam, "Pomoz mi držet rytmus! Mačkej šipky, až dopadnou na terčíky.", "", "avatar")
	set_global("concert_play", true)

:concert_end
	# Spouští concert_show.gd, když písničky dohrají (nebo je hráč přeskočí).
	# Po koncertu je 22:00 (noc). Část dne se nastaví hned, jinak by hodiny
	# spustily mrknutí. Rozvrh ručně: v noci je večerka zavřená.
	set_global("day_minute", 1320)
	set_global("day_phase", "night")
	set_global("shop_open", false)
	set_global("concert_seen", true)
	set_global("clock_enabled", true)
	play_snd("res://sound/music/sneakySong.mp3", "_music")
	change_scene("res://rooms/fit_front/fit_front.tscn")
