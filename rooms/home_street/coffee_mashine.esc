:look
	say($olda, "Kávovej automat. Kafe za dvacku.")
	say($aidam, "Lidi tam občas zapomenou drobný.", "", "avatar")

:pickup
	if not machine_coins_taken:
		say($olda, "Ve vracení mincí někdo zapomněl drobný. ")
		if not coins_have:
			inventory_add("coins")
			set_global("coins_have", true)
		set_global("machine_coins_taken", true)
	else:
		say($olda, "Už je tam prázdno.")

:use
	if coins_have:
		say($olda, "Musím do toho hodit drobný.")
	else:
		say($olda, "Kdybych měl pár drobnejch, natočil bych si kafe.")

:use coins
	if not coffee_made:
		say($olda, "Jedno kafe. Zbytek drobnejch si nechám.")
		set_active("coffee", true)
		set_global("coffee_made", true)
	elif not coffee_taken:
		say($olda, "Kafe už je hotový, stačí si ho vzít.")
	else:
		say($olda, "Jedno kafe stačí.")
