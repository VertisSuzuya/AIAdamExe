:setup
	# Příchod: Olda stojí u východu, ze kterého přišel.
	if ESC_LAST_SCENE == "oldas_room":
		teleport($olda, $exit_to_room)
	elif ESC_LAST_SCENE == "corner_shop":
		teleport($olda, $exit_to_corner_shop)
	else:
		teleport($olda, $player_start)
		
:apply_time
	# Co je na ulici vidět podle dne a příznaků.
	# Spouští ho game_clock po :setup, po načtení hry a při změně času.

	# Úterý: opilec u večerky, dokud ho Olda neodežene.
	if game_day == 1 and not drunk_gone:
		set_active("drunk", true)
	else:
		set_active("drunk", false)

	# Lahve u výlohy leží, dokud je Olda nesebere.
	if not bottles_taken:
		set_active("bottles", true)
	else:
		set_active("bottles", false)

	# Kelímek je v automatu, jen když je kafe uvařené a ještě nesebrané.
	if coffee_made and not coffee_taken:
		set_active("coffee", true)
	else:
		set_active("coffee", false)