:look
	if camera_placed and not camera_taken:
		say($olda, "Kamera je pořád mezi větvemi. Kouká přímo na verandu.")
	else:
		say($olda, "Keře u plotu. Je odsud vidět přímo na verandu souseda.")

:use camera
	if game_day == 4:
		accept_input("SKIP")
		say($olda, "Soused se zrovna dívá jinam. Tady... mezi větve, objektivem na verandu.")
		inventory_remove("camera")
		set_global("camera_placed", true)
		set_global("diary_camera_placed", true)
		say($aidam, "Hraješ si na detektiva. Dobře. Zítra uvidíme, kdo měl pravdu.", "", "avatar")
		accept_input("ALL")
	else:
		say($olda, "Teď ne.")
		

:use
	if game_day == 5 and camera_placed and not camera_taken:
		if day_minute < 960:
			say($olda, "Teď ne. Policajt stojí pár metrů odsud.")
		else:
			accept_input("SKIP")
			say($olda, "Pořád tam je. Mokrá, ale celá.")
			inventory_add("camera")
			set_global("camera_taken", true)
			set_global("diary_camera_taken", true)
			say($olda, "Nahrávala celou noc. Musím to vidět.")
			say($olda, "Vietnamec říkal, že mi záznam přetáhne do počítače.")
			say($aidam, "Uvidíš souseda, jak se plíží kolem domu. Říkal jsem ti to.", "", "avatar")
			accept_input("ALL")
	else:
		say($olda, "Jen mokrý keře.")
