:use
	if game_day >= 5:
		# Sobota: lehnout si = věřit AIdamovi = pohlcení.
		if news_seen:
			say($olda, "Jestli si teď lehnu, už se nemusím probudit.")
			say($aidam, "Jen na chvilku. Zavři oči. Já to pohlídám.", "", "avatar")
			?!
				- "Lehnout si."
					set_global("fell_asleep", true)
					set_global("ending_kind", "aidam")
					accept_input("SKIP")
					transition("fade_black", "out", 1.5)
					accept_input("ALL")
					change_scene("res://rooms/ending/ending.tscn")
					done
				- "Ne. Vydržím."
					done
		else:
			say($olda, "Teď ne. Nejdřív musím zjistit, co se děje.")
	elif day_task_done:
		say($olda, "Jsem pro dnešek hotovej. Dobrou.")
		if game_day == 0:
			say($aidam, "Dobrou noc. Já tě pohlídám.", "", "avatar")
			say($olda, "Počkej, co přesně tím myslíš...")
		# Nový den spustí game_clock (:new_day v game.esc), až tahle událost skončí.
		set_global("sleep_requested", true)
	elif game_day == 0 and not alarm_set:
		say($aidam, "Bez budíku? Zaspíš a pak budeš vinit mě.", "", "avatar")
	else:
		say($aidam, "Ještě nemůžeš spát, dnes máš něco nedodělaného.", "", "avatar")
