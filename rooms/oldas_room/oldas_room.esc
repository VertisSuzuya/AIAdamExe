:setup
	# Příchod z ulice: Olda stojí u dveří, jinak (laboratoř, nový den) na startu.
	if ESC_LAST_SCENE == "home_street":
		teleport($olda, $exit_to_street)
	else:
		teleport($olda, $oldas_room_start_location)
	# Pondělí: Olda se z laboratoře dostane domů ve 22:00, teprve teď
	# se spustí hodiny (do 2:00 má čas na tutorial).
	if not clock_enabled:
		set_global("day_minute", 1320)
		set_global("day_phase", "night")
		set_global("clock_enabled", true)
		# Začátek pondělí: game_clock uloží checkpoint (ve 2:00 se sem hráč vrátí).
		set_global("checkpoint_pending", true)
	if alarm_taken:
		set_active("alarm", false)
	if battery_taken:
		set_active("batteries", false)
		
:ready
	if tutorial_step == 0:
		say($aidam, "Vítej doma. Prvně tě naučím jak se pohybovat po scéně.", "", "avatar")
		say($aidam, "Abys šel, musíš... zatnout pravou půlku mozku. Nebo klikat myší. Jedno z toho.", "", "avatar")
		say($aidam, "Zkus dojít k oknu.", "", "avatar")
		set_global("tutorial_step", 1)
	
:morning
	# Spouští game_clock po probuzení (po mrknutí). Repliky podle dne.
	if game_day == 2:
		say($olda, "Pořád mi vrtá hlavou, co mi to vlastně dali do hlavy.")
		say($olda, "Rád bych se o umělý inteligenci dozvěděl víc. Ale kde?")
		say($aidam, "Co třeba Dejvice? Na ČVUT FIT tohle studujou. Studenti o tom budou vědět víc než já. Skoro.", "", "avatar")
		set_global("stop_dejvice", true)
		set_global("diary_stop_dejvice", true)
		say($aidam, "Přidal jsem ti Dejvice na mapu linek, pokud by jsi se tam chtěl podívat:)", "", "avatar")
