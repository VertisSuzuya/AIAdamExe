:setup
	teleport($olda, $oldas_room_start_location)
	# Pondělí: Olda se z laboratoře dostane domů ve 22:00, teprve teď
	# se spustí hodiny (do 2:00 má čas na tutorial).
	if not clock_enabled:
		set_global("day_minute", 1320)
		set_global("day_phase", "night")
		set_global("clock_enabled", true)
		# Začátek pondělí: game_clock uloží checkpoint (ve 2:00 se sem hráč vrátí).
		set_global("checkpoint_pending", true)
	if alarm_taken:
		set_active("alarm", false)
	if battery_taken:
		set_active("batteries", false)
		
:ready
	if tutorial_step == 0:
		say($aidam, "Vítej doma. Prvně tě naučím jak se pohybovat po scéně.", "", "avatar")
		say($aidam, "Abys šel, musíš... zatnout pravou půlku mozku. Nebo klikat myší. Jedno z toho.", "", "avatar")
		say($aidam, "Zkus dojít k oknu.", "", "avatar")
		set_global("tutorial_step", 1)
	
