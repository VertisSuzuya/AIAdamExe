:setup
	# Příchod z ulice: Olda stojí u dveří, jinak (laboratoř, nový den) na startu.
	if blackout_home:
		teleport($olda, $nightstand)
	elif ESC_LAST_SCENE == "home_street":
		teleport($olda, $exit_to_street)
	elif ESC_LAST_SCENE == "tv_news":
		teleport($olda, $tv)
	else:
		teleport($olda, $oldas_room_start_location)
	# Pondělí: Olda se z laboratoře dostane domů ve 21:00, teprve teď
	# se spustí hodiny (do 1:00 má čas na tutorial).
	if not clock_enabled:
		set_global("day_minute", 1260)
		set_global("day_phase", "evening")
		set_global("clock_enabled", true)
		# Začátek pondělí: game_clock uloží checkpoint (v 1:00 se sem hráč vrátí).
		set_global("checkpoint_pending", true)
	if alarm_taken:
		set_active("alarm", false)
	if battery_taken:
		set_active("batteries", false)
		
:ready
	#start questu v pondeli
	if tutorial_step == 0:
		say($aidam, "Vítej doma. Prvně tě naučím jak se pohybovat po scéně.", "", "avatar")
		say($aidam, "Abys šel, musíš... zatnout pravou půlku mozku. Nebo klikat myší. Jedno z toho.", "", "avatar")
		say($aidam, "Zkus dojít k oknu.", "", "avatar")
		set_global("tutorial_step", 1)
	# Úterý po hodinkách: rozhovor o rodině, AIdam odemkne Centrum.
	################upravit aby to nebylo hned pri spusteni sceny...
	if game_day == 1 and watch_taken and not home_talk_done:
		set_global("home_talk_done", true)
		accept_input("SKIP")
		say($olda, "Tak hodinky mám. Ale stejně...")
		walk_block($olda, $oldas_family_picture)
		turn_to($olda, $oldas_family_picture)
		say($olda, "Pořád myslím na ně. Snad mi jednou dají ještě šanci.")
		say($aidam, "Upřímně? Takhle, jak vypadáš, ti ji nedají.", "", "avatar")
		say($aidam, "Vousy jak trosečník, vlasy jak po výbuchu. Musíš se sebou něco udělat.", "", "avatar")
		say($olda, "A za co? Nemám ani korunu.")
		say($aidam, "Podle smlouvy ti peníze přijdou zítra. Ale můžeme se aspoň jít podívat, kam pak zajdeš.", "", "avatar")
		say($aidam, "V centru je salon, hned vedle policejní stanice. Přidal jsem ti Centrum na mapu linek.", "", "avatar")
		set_global("stop_center", true)
		set_global("diary_stop_center", true)
		accept_input("ALL")
		# Sobota po zprávách: Olda začíná tušit, AIdam zapírá.
	if ESC_LAST_SCENE == "tv_news":
		accept_input("SKIP")
		say($olda, "Ve tři ráno. Mokrý stopy. Peníze pryč.")
		if knife_found:
			say($olda, "A nůž v šuplíku.")
		say($olda, "Byl jsem to já?")
		say($aidam, "Ne. Poslouchej mě, Oldo. Jsi vyčerpanej. Mozek si spojuje věci, který spolu nesouvisí.", "", "avatar")
		say($aidam, "Lehni si. Vyspi se. Až se probudíš, bude všechno dávat smysl.", "", "avatar")
		say($olda, "Pokaždý, když usnu, se něco stane.")
		say($olda, "Ne. Dneska spát nebudu. Potřebuju vědět, co jsem dělal. A potřebuju to dokázat.")
		if camera_placed:
			say($olda, "Kamera! Je pořád v keři na Konečné. Musela natočit, co se tam v noci dělo.")
		if knife_found:
			say($olda, "A ten nůž je z večerky. Vietnamec si bude pamatovat, kdo ho kupoval.")
		else:
			say($olda, "Ty stopy vedou k nočnímu stolku. Co tam je?")
		say($aidam, "Děláš velkou chybu, Oldo. Já ti jen chci pomoct.", "", "avatar")
		set_global("diary_news_seen", true)
		accept_input("ALL")
		# Sobota v noci: výpadek, Olda se probere u šuplíku (game.esc :half_hour).
	if blackout_home:
		queue_event("oldas_room", "wake_home")

:morning
	# Spouští game_clock po probuzení (po mrknutí). Repliky podle dne.
	if game_day == 1:
		say($olda, "Doma mám aspoň budík. Venku ale nebudu mít tušení, kolik je hodin.")
		say($olda, "Měl bych si sehnat hodinky.")
		say($aidam, "Já bych ti čas klidně hlásil. Kdybych ho ovšem věděl.", "", "avatar")
		say($olda, "Je tu takový ticho... Chybí mi.")
		say($aidam, "Smutnit můžeš i venku, pojďmě na to postupně, prvně seženeme nějaký ty hodinky, pak budeme řešit rodinu.", "", "avatar")
	elif game_day == 2:
		say($olda, "Pořád mi vrtá hlavou, co mi to vlastně dali do hlavy.")
		say($olda, "Rád bych se o umělý inteligenci dozvěděl víc. Ale kde?")
		say($aidam, "Jedno místo bych znal. Ale takhle tě tam nepustím, vyděsil bys je.", "", "avatar")
		say($aidam, "Nejdřív salon. Až se dáš do pucu, přidám ti ho na mapu.", "", "avatar")
		walk_block($olda, $envelope)
		say($olda, "Hele, obálka. Ta tu včera nebyla.")
		say($aidam, "Že by výplata? Vezmi ji a otevři.", "", "avatar")
	elif game_day == 3:
		say($olda, "Tak. Vypadám zase jako člověk. Peníze na pár dní mám. Práci si najdu.")
		say($olda, "A... počkej.")
		say($olda, "Já si to číslo pamatuju! Celý, číslo po čísle.")
		say($aidam, "Říkal jsem, že ve spánku to jde líp. Nemusíš děkovat. Ale můžeš.", "", "avatar")
		say($aidam, "Telefonní budka je hned před domem. Tak co, zavoláš jim?", "", "avatar")
		set_global("wife_number_known", true)
	elif game_day == 4:
		accept_input("SKIP")
		say($olda, "Co to je? Stopy... mokrý. Od dveří až k posteli.")
		say($olda, "Já byl v noci venku?")
		say($aidam, "V noci pršelo. Možná jsi byl náměsíčnej. Nebo jsi šel vynést koš a zapomněl na to. Lidi zapomínaj spoustu věcí.", "", "avatar")
		say($aidam, "Hlavně se nestresuj. Dneska je velkej den. Dvanáct hodin, první lavička, pamatuješ?", "", "avatar")
		accept_input("ALL")
	elif game_day == 5:
		accept_input("SKIP")
		inventory_remove("money")
		say($olda, "Zase stopy. Mokrý. Od dveří až k nočnímu stolku... a pak do postele.")
		say($olda, "To zase pršelo? A já byl zase venku?")
		say($aidam, "Měl jsi neklidnou noc, to je celý. Nic se neděje.", "", "avatar")
		say($olda, "Počkej. Kde mám peníze? Celá obálka. Byla tady.")
		say($aidam, "Možná jsi je někde nechal. Včera jsi byl dost rozhozenej.", "", "avatar")
		say($olda, "Něco je špatně. Pustím si zprávy.")
		# Od soboty čas běží přes 1:00 až do konce hry.
		set_global("no_day_limit", true)
		accept_input("ALL")

:apply_time
	# Obálka od firmy leží na stolku od středy, dokud ji Olda nesebere.
	if game_day >= 2 and not envelope_taken:
		set_active("envelope", true)
	else:
		set_active("envelope", false)
		
	# Pátek ráno: mokré stopy od dveří k posteli.
	if game_day == 4:
		set_active("footprints_friday", true)
	else:
		set_active("footprints_friday", false)
		
	# Sobota: stopy k nočnímu stolku.
	if game_day == 5:
		set_active("footprints_saturday", true)
	else:
		set_active("footprints_saturday", false)


:wake_home
	accept_input("SKIP")
	set_global("blackout_home", false)
	say($olda, "...Jsem doma? U šuplíku.")
	say($olda, "A v ruce... nůž.")
	say($aidam, "Pořád ho chceš nosit u sebe? Tak si ho nech. Možná se ti bude hodit.", "", "avatar")
	say($olda, "Co tím myslíš?")
	say($aidam, "Nic. Jsem jen unavenej. Jako ty.", "", "avatar")
	accept_input("ALL")
