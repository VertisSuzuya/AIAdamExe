:look
	if game_day >= 4:
		say($olda, "Kavárna. Tady jsme seděli všichni tři nedávno.")
	else:
		say($olda, "Malá kavárna. Vypadá útulně.")

:use
	# Čtvrtek: setkání s Janou a Klárkou ve 14:00 (do 14:15, pak odejdou).
	if game_day == 3 and wife_called and not family_met:
		if day_minute > 855:
			accept_input("SKIP")
			say($olda, "Jsou pryč...")
			say($aidam, "Čtvrt na tři. Čekaly. A pak odešly.", "", "avatar")
			say($olda, "Zase jsem to podělal. Přesně jak to Jana čekala.")
			say($aidam, "Zkusíme to znovu. Od rána.", "", "avatar")
			accept_input("ALL")
			set_global("checkpoint_load_requested", true)
		else:
			if day_minute < 840:
				say($aidam, "Je brzo, sraz je ve dvě. Počkáme uvnitř?", "", "avatar")
				?!
					- "Počkáme."
						say($olda, "Radši budu první.")
						set_global("day_minute", 840)
						done
					- "Ještě se projdu."
						say($aidam, "Hlavně ať jsi tu ve dvě!", "", "avatar")
						done
			if day_minute >= 840:
				say($aidam, "Jsou tam. U okna. Tak jdeme.", "", "avatar")
				change_scene("res://rooms/cafe_meeting/cafe_meeting.tscn")
	elif game_day == 3 and family_met:
		say($olda, "Krásný odpoledne. Teď domů.")
	elif game_day == 3:
		say($olda, "Stůl mám zamluvenej na dnešek. Ale nejdřív bych měl zavolat Janě.")
	elif game_day >= 4:
		say($olda, "Tady jsme nedávno seděli všichni tři.")
	elif cafe_reserved:
		say($olda, "Rezervaci na zítra už mám.")
	else:
		accept_input("SKIP")
		say($olda, "Tady to vypadá hezky. Sem bych je mohl vzít.")
		say($aidam, "Útulný, ne moc drahý a dcera tu dostane horkou čokoládu. Schvaluju.", "", "avatar")
		say($aidam, "Zarezervuj stůl na zítřek odpoledne. Kdyby žena souhlasila, už ho budeš mít.", "", "avatar")
		say($olda, "A když nebude chtít?")
		say($aidam, "Tak sníš dva dorty sám. Výhra na obou stranách.", "", "avatar")
		transition("fade_black", "out", 0.5)
		set_global("day_minute", day_minute + 15)
		teleport($olda, $cafe_door)
		set_angle($olda, 180)
		set_global("cafe_reserved", true)
		set_global("diary_cafe_reserved", true)
		transition("fade_black", "in", 0.5)
		say($olda, "Stůl pro tři, zítra odpoledne. Mám to.")
		say($aidam, "Výborně. A teď to nejdůležitější: Mutanti! V šest v atriu. Ani o minutu později.", "", "avatar")
		accept_input("ALL")
