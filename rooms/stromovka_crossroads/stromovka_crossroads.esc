:setup
	if ESC_LAST_SCENE == "stromovka_long":
		teleport($olda, $exit_to_long)
		set_angle($olda, 60)
	elif ESC_LAST_SCENE == "fit_front":
		teleport($olda, $exit_to_fit_front)
	else:
		teleport($olda, $player_start)
	if brick_taken:
		set_active("brick", false)

:apply_time
	# Ve středu je cesta do dlouhého parku zavřená stavbou (ve čtvrtek hotovo).
	if game_day == 2:
		set_active("construction", true)
	else:
		set_active("construction", false)
