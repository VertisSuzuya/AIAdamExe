:setup
	print("test setup")
	play_snd("res://sound/music/sneakySong.mp3", _music)
	if ESC_LAST_SCENE == "stromovka_long":
		teleport($olda, $exit_to_long)
		set_angle($olda, 60)
	else:
		teleport($olda, $player_start)
	if brick_taken:
		set_active("brick", false)
:ready
	print("testuju ready")
	say($olda, "Testuju hudbu")
